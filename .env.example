# GCP
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Grafana Cloud OTLP ingest (metrics + traces) — stack Details > OpenTelemetry > Configure.
# GRAFANA_INSTANCE_ID is the plain numeric ID shown on that page (e.g. 1779504).
# GRAFANA_OTLP_TOKEN is the raw API token from "Generate now" on that same page —
# paste it in as-is, do not base64-encode it yourself, the code does that.
GRAFANA_OTLP_ENDPOINT=
GRAFANA_INSTANCE_ID=
GRAFANA_OTLP_TOKEN=

# Grafana MCP (agent only) — service account token, NOT the interactive OAuth flow,
# since the agent runs unattended behind an alert webhook
GRAFANA_STACK_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# pipeline/chaos only, once infra/deploy.sh has produced real Cloud Run URLs
INGEST_URL=
SCHEDULER_URL=
